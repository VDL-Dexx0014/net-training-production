# Local environment variables example
# Copy this file to .env.local and fill the values for local development.

# Public Supabase URL (allowed to be public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public (client) anon key - safe for client usage but not for server privileged ops.
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-public-key-here

# Server-only Supabase service role key (DO NOT commit to repo). Use this only on the server.
# Example name: SUPABASE_SERVICE_ROLE_KEY (access only in server environment, not NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# Node environment
NODE_ENV=development

# Optional: change port if needed
PORT=3000

# NOTE: Do NOT store production secrets in the repository. Use your host's secret manager
# (Vercel, Netlify, Docker secrets, etc.) for production deployments.
